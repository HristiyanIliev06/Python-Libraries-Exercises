PATTERNS
--------

STANDALONE GENERATOR FUNCTION — simple, self-contained, owns its data source
  def token_batches(filepath, batch_size):
      with open(filepath) as f:
          batch = []
          for line in f:
              tokens = line.strip().split()
              if not tokens:
                  continue
              batch.extend(tokens)
              if len(batch) >= batch_size:
                  yield batch[:batch_size]
                  batch = batch[batch_size:]
          if batch:
              yield batch

CLASS-BASED ITERABLE — reusable, separates config from iteration state
  class DatasetIterable:
      def __init__(self, samples):
          self.samples = samples

      def __iter__(self):
          for sample in self.samples:
              yield sample

CLASS-BASED ITERATOR — holds state, single-pass only
  class DatasetIterator:
      def __init__(self, samples):
          self.samples = samples
          self.index = 0

      def __iter__(self):
          self.index = 0
          return self

      def __next__(self):
          if self.index >= len(self.samples):
              raise StopIteration
          sample = self.samples[self.index]
          self.index += 1
          return sample

CHAINABLE LAZY PIPELINE
  class Pipeline:
      def __init__(self, iterator):
          self.iterator = iterator

      def map(self, func):
          return Pipeline(map(func, self.iterator))

      def filter(self, pred):
          return Pipeline(filter(pred, self.iterator))

      def batch(self, n):
          def _batcher(it):
              current = []
              for item in it:
                  current.append(item)
                  if len(current) == n:
                      yield current
                      current = []
              if current:
                  yield current
          return Pipeline(_batcher(self.iterator))

      def __iter__(self):
          return iter(self.iterator)

DIRECTORY-BASED CORPUS PIPELINE (Project 1 pattern)
  from pathlib import Path
  import random

  class Pipeline:
      def __init__(self, directory, batch_size, max_tokens=None, shuffle=False):
          self.files = sorted(Path(directory).glob("*.txt"))
          self.batch_size = batch_size
          self.max_tokens = max_tokens
          self.shuffle = shuffle

      def _get_files(self):
          files = list(self.files)
          if self.shuffle:
              random.shuffle(files)
          return files

      def __iter__(self):
          token_counter = 0
          batch = []
          for file in self._get_files():
              with open(file) as f:
                  for line in f:
                      tokens = line.strip().split()
                      if not tokens:
                          continue
                      if self.max_tokens is not None:
                          remaining = self.max_tokens - token_counter
                          tokens = tokens[:remaining]
                      token_counter += len(tokens)
                      batch.extend(tokens)
                      while len(batch) >= self.batch_size:
                          yield batch[:self.batch_size]
                          batch = batch[self.batch_size:]
                      if self.max_tokens and token_counter >= self.max_tokens:
                          if batch:
                              yield batch
                          return
          if batch:
              yield batch

